<% layout("layouts/boilerplate") %>

<div class="container py-5 min-vh-75 d-flex align-items-center justify-content-center">
  <div class="row justify-content-center w-100">
    <div class="col-md-7 col-lg-5">
      <div class="glass-card p-4 p-md-5">
        <div class="text-center mb-4">
          <div class="rounded-circle d-inline-flex p-3 mb-2" style="background: rgba(99, 102, 241, 0.15);">
            <i class="fa-solid fa-user-plus fs-3 text-primary"></i>
          </div>
          <h3 class="fw-bold text-white mb-1">Create Account</h3>
          <p class="text-secondary small">Start automating reminders and collecting payments.</p>
        </div>

        <form action="/signup" method="POST" class="form-dark">
          <div class="mb-3">
            <label for="name"><i class="fa-solid fa-user me-1 text-primary"></i> Full Name</label>
            <input type="text" class="form-control" id="name" name="name" placeholder="John Doe" required>
          </div>

          <div class="mb-3">
            <label for="email"><i class="fa-solid fa-envelope me-1 text-primary"></i> Email Address</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="you@example.com" required>
          </div>

          <div class="mb-4">
            <label for="password"><i class="fa-solid fa-lock me-1 text-primary"></i> Create Password</label>
            <input type="password" class="form-control" id="password" name="password" placeholder="At least 6 characters" minlength="6" required>
          </div>

          <button type="submit" class="btn btn-primary-gradient w-100 py-3 rounded-pill fw-bold fs-6 mb-3">
            <i class="fa-solid fa-rocket me-1"></i> Register Free
          </button>
        </form>

        <p class="text-center text-secondary small mb-0">
          Already registered? <a href="/login" class="text-primary text-decoration-none fw-semibold">Sign in</a>
        </p>
      </div>
    </div>
  </div>
</div>
