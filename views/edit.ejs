<% layout("layouts/boilerplate") %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="glass-card p-4 p-md-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h3 class="fw-bold text-white mb-0">
            <i class="fa-solid fa-pen-to-square text-primary me-2"></i> Edit Customer
          </h3>
          <a href="/customers" class="btn btn-sm btn-outline-light rounded-pill px-3">Cancel</a>
        </div>

        <form action="/customers/<%= customer._id %>/edit" method="POST" class="form-dark">
          <div class="mb-3">
            <label for="name"><i class="fa-solid fa-user me-1 text-primary"></i> Customer Name</label>
            <input type="text" class="form-control" id="name" name="name" value="<%= customer.name %>" required>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="email"><i class="fa-solid fa-envelope me-1 text-primary"></i> Email Address</label>
              <input type="email" class="form-control" id="email" name="email" value="<%= customer.email %>" required>
            </div>
            <div class="col-md-6">
              <label for="phone"><i class="fa-solid fa-phone me-1 text-primary"></i> Mobile Number</label>
              <input type="tel" class="form-control" id="phone" name="phone" value="<%= customer.phone || '' %>">
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="amount"><i class="fa-solid fa-indian-rupee-sign me-1 text-primary"></i> Amount Due (₹)</label>
              <input type="number" step="0.01" class="form-control" id="amount" name="amount" value="<%= customer.amount %>" required>
            </div>
            <div class="col-md-6">
              <label for="dueDate"><i class="fa-solid fa-calendar me-1 text-primary"></i> Due Date</label>
              <input type="date" class="form-control" id="dueDate" name="dueDate" value="<%= new Date(customer.dueDate).toISOString().split('T')[0] %>" required>
            </div>
          </div>

          <div class="mb-3">
            <label for="notes"><i class="fa-solid fa-note-sticky me-1 text-primary"></i> Description / Notes</label>
            <input type="text" class="form-control" id="notes" name="notes" value="<%= customer.notes || '' %>">
          </div>

          <div class="mb-4">
            <label for="isPaid"><i class="fa-solid fa-credit-card me-1 text-primary"></i> Payment Status</label>
            <select class="form-select" id="isPaid" name="isPaid">
              <option value="false" <%= !customer.isPaid ? 'selected' : '' %>>Pending</option>
              <option value="true" <%= customer.isPaid ? 'selected' : '' %>>Paid / Settled</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary-gradient w-100 py-3 rounded-pill fw-bold">
            <i class="fa-solid fa-check me-1"></i> Update Record
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
