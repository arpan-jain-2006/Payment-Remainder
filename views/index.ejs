<% layout("layouts/boilerplate") %>

<!-- Hero Section -->
<section class="py-5 text-center position-relative">
  <div class="container py-lg-4">
    <div class="row justify-content-center">
      <div class="col-lg-9">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-4" style="background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.25);">
          <i class="fa-solid fa-sparkles text-warning"></i>
          <span class="small fw-semibold text-white">Smart Automated Billing & Dues Tracker</span>
        </div>

        <h1 class="display-4 fw-extrabold text-white mb-3">
          Never Chase a <span style="background: linear-gradient(135deg, #818cf8 0%, #c084fc 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Payment Again</span>
        </h1>
        
        <p class="lead text-secondary mb-4 mx-auto" style="max-width: 680px; font-size: 1.15rem;">
          Schedule timely reminders, dispatch professional email notices at 9:00 AM automatically, and collect payments directly via Razorpay and UPI.
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-3 mb-5">
          <a href="/customers" class="btn btn-primary-gradient btn-lg rounded-pill px-5 py-3 d-flex align-items-center gap-2">
            <span>Manage Customers</span>
            <i class="fa-solid fa-arrow-right"></i>
          </a>
          <a href="/add" class="btn btn-outline-light btn-lg rounded-pill px-4 py-3">
            <i class="fa-solid fa-plus me-1"></i> Add Reminder
          </a>
          <a href="/dashboard" class="btn btn-dark border-secondary btn-lg rounded-pill px-4 py-3">
            <i class="fa-solid fa-chart-line me-1"></i> View Analytics
          </a>
        </div>
      </div>
    </div>

    <!-- Feature Cards -->
    <div class="row g-4 mt-2 text-start">
      <div class="col-md-4">
        <div class="glass-card p-4 h-100">
          <div class="kpi-icon" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">
            <i class="fa-solid fa-envelope-open-text"></i>
          </div>
          <h4 class="fw-bold text-white mb-2">Automated 9 AM Alerts</h4>
          <p class="text-secondary mb-0">Built-in cron engine automatically scans overdue records and delivers beautifully formatted email invoices with direct payment links.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="glass-card p-4 h-100">
          <div class="kpi-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
            <i class="fa-solid fa-credit-card"></i>
          </div>
          <h4 class="fw-bold text-white mb-2">Razorpay & UPI Payments</h4>
          <p class="text-secondary mb-0">Customers receive immediate access to a secure payment checkout supporting UPI apps, credit/debit cards, and netbanking.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="glass-card p-4 h-100">
          <div class="kpi-icon" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24;">
            <i class="fa-solid fa-chart-pie"></i>
          </div>
          <h4 class="fw-bold text-white mb-2">Real-time Dues Dashboard</h4>
          <p class="text-secondary mb-0">Instantly monitor total pending cashflow, upcoming 7-day deadlines, and overdue accounts with real-time indicators.</p>
        </div>
      </div>
    </div>
  </div>
</section>
