<% layout("layouts/boilerplate") %>

<div class="container py-5 min-vh-75 d-flex align-items-center justify-content-center text-center">
  <div class="glass-card p-5" style="max-width: 500px;">
    <div class="rounded-circle d-inline-flex p-4 mb-3" style="background: rgba(239, 68, 68, 0.15);">
      <i class="fa-solid fa-triangle-exclamation fs-1 text-danger"></i>
    </div>
    <h2 class="fw-bold text-white mb-2"><%= typeof title !== 'undefined' ? title : 'Page Not Found' %></h2>
    <p class="text-secondary mb-4"><%= typeof message !== 'undefined' ? message : 'The page you are looking for might have been removed or is temporarily unavailable.' %></p>
    <a href="/" class="btn btn-primary-gradient rounded-pill px-4 py-2">
      <i class="fa-solid fa-house me-1"></i> Return Home
    </a>
  </div>
</div>
