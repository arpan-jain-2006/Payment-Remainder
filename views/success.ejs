<% layout("layouts/boilerplate") %>

<div class="container py-5 min-vh-75 d-flex align-items-center justify-content-center">
  <div class="row justify-content-center w-100">
    <div class="col-md-7 col-lg-5">
      <div class="glass-card p-4 p-md-5 text-center">
        <!-- Success Icon -->
        <div class="rounded-circle d-inline-flex p-4 mb-3" style="background: rgba(16, 185, 129, 0.15);">
          <i class="fa-solid fa-circle-check fs-1 text-success"></i>
        </div>

        <h3 class="fw-bold text-white mb-1">Payment Successful!</h3>
        <p class="text-secondary small mb-4">Your payment has been recorded and acknowledged.</p>

        <!-- Receipt Details -->
        <div class="p-3 rounded-3 text-start mb-4" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);">
          <div class="d-flex justify-content-between mb-2 small text-secondary">
            <span>Customer:</span>
            <span class="text-white fw-semibold"><%= customer.name %></span>
          </div>
          <div class="d-flex justify-content-between mb-2 small text-secondary">
            <span>Email:</span>
            <span class="text-white"><%= customer.email %></span>
          </div>
          <div class="d-flex justify-content-between mb-2 small text-secondary">
            <span>Payment ID:</span>
            <span class="text-white font-monospace small"><%= paymentId %></span>
          </div>
          <div class="d-flex justify-content-between mb-2 small text-secondary">
            <span>Payment Date:</span>
            <span class="text-white"><%= new Date(customer.paidAt || Date.now()).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
          </div>
          <hr style="border-color: rgba(255,255,255,0.1); margin: 12px 0;">
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-secondary fw-semibold">Amount Paid:</span>
            <span class="fs-4 fw-bolder text-success">₹<%= formatINR(customer.amount) %></span>
          </div>
        </div>

        <div class="d-flex flex-wrap gap-2 justify-content-center">
          <button onclick="window.print()" class="btn btn-outline-light rounded-pill px-4">
            <i class="fa-solid fa-print me-1"></i> Print Receipt
          </button>
          <a href="/customers" class="btn btn-primary-gradient rounded-pill px-4">
            <i class="fa-solid fa-users me-1"></i> Back to Customers
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
