<% layout("layouts/boilerplate") %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="glass-card p-4 p-md-5">
        <div class="text-center mb-4">
          <div class="rounded-circle d-inline-flex p-3 mb-2" style="background: rgba(99, 102, 241, 0.15);">
            <i class="fa-solid fa-user-plus fs-3 text-primary"></i>
          </div>
          <h3 class="fw-bold text-white mb-1">Create Payment Reminder</h3>
          <p class="text-secondary small">Set up a customer due date to automate daily email alerts.</p>
        </div>

        <form action="/add" method="POST" class="form-dark">
          <div class="mb-3">
            <label for="name"><i class="fa-solid fa-user me-1 text-primary"></i> Full Name *</label>
            <input type="text" class="form-control" id="name" name="name" placeholder="e.g. Rahul Sharma" required>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="email"><i class="fa-solid fa-envelope me-1 text-primary"></i> Email Address *</label>
              <input type="email" class="form-control" id="email" name="email" placeholder="client@example.com" required>
            </div>
            <div class="col-md-6">
              <label for="phone"><i class="fa-solid fa-phone me-1 text-primary"></i> Mobile Number</label>
              <input type="tel" class="form-control" id="phone" name="phone" placeholder="+91 9876543210">
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="amount"><i class="fa-solid fa-indian-rupee-sign me-1 text-primary"></i> Amount Due (₹) *</label>
              <input type="number" step="0.01" min="1" class="form-control" id="amount" name="amount" placeholder="e.g. 5000" required>
            </div>
            <div class="col-md-6">
              <label for="dueDate"><i class="fa-solid fa-calendar me-1 text-primary"></i> Due Date *</label>
              <input type="date" class="form-control" id="dueDate" name="dueDate" required>
            </div>
          </div>

          <div class="mb-4">
            <label for="notes"><i class="fa-solid fa-note-sticky me-1 text-primary"></i> Description / Notes</label>
            <input type="text" class="form-control" id="notes" name="notes" placeholder="e.g. Web Development Invoice #102">
          </div>

          <button type="submit" class="btn btn-primary-gradient w-100 py-3 rounded-pill fw-bold fs-6">
            <i class="fa-solid fa-paper-plane me-1"></i> Save Reminder & Schedule
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
